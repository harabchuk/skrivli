#include "resource.h"
#include <windows.h>
#include <winres.h>
#include <atlres.h>

IDI_TRAY_IDLE      ICON "tray_idle.ico"
IDI_TRAY_RECORDING ICON "tray_recording.ico"

IDR_MAINFRAME ICON "app.ico"

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Open &recordings folder", ID_FILE_OPENFOLDER
        MENUITEM "Se&ttings...",            ID_FILE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Skrivli...",  ID_APP_ABOUT
    END
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "&Show Skrivli",      ID_TRAY_SHOW
        MENUITEM "&Start recording",        ID_TRAY_STARTSTOP
        MENUITEM SEPARATOR
        MENUITEM "Open &recordings folder", ID_TRAY_OPENFOLDER
        MENUITEM "Se&ttings...",            ID_TRAY_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   ID_TRAY_EXIT
    END
END

IDD_RECORD_PAGE DIALOGEX 0, 0, 360, 280
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Input", IDC_INPUT_SECTION, 12, 6, 336, 14, SS_OWNERDRAW
    RTEXT           "&Microphone", IDC_MIC_LABEL, 12, 26, 70, 10
    COMBOBOX        IDC_MIC_DEVICE, 90, 24, 258, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    RTEXT           "&System audio", IDC_SYSTEM_LABEL, 12, 46, 70, 10
    COMBOBOX        IDC_SYSTEM_DEVICE, 90, 44, 258, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Output", IDC_OUTPUT_SECTION, 12, 68, 336, 14, SS_OWNERDRAW
    RTEXT           "Save &to", IDC_FOLDER_LABEL, 12, 88, 70, 10
    EDITTEXT        IDC_FOLDER_PATH, 90, 86, 200, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_BROWSE_FOLDER, 296, 85, 52, 16, WS_TABSTOP

    PUSHBUTTON      "&Start recording", IDC_RECORD_BUTTON, 100, 118, 160, 36, WS_TABSTOP
    CTEXT           "00:00:00", IDC_ELAPSED, 100, 160, 160, 18
    CTEXT           "", IDC_REC_INDICATOR, 100, 180, 160, 10

    LTEXT           "Mic", IDC_MIC_METER_LABEL, 12, 202, 40, 10
    LTEXT           "", IDC_METER_MIC, 54, 200, 250, 14, SS_NOTIFY
    RTEXT           "-inf dB", IDC_MIC_DB, 308, 202, 40, 10
    LTEXT           "Gain", IDC_MIC_GAIN_LABEL, 12, 222, 40, 10
    CONTROL         "", IDC_MIC_GAIN, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_TOOLTIPS | WS_TABSTOP, 54, 221, 160, 18
    LTEXT           "1.0×", IDC_MIC_GAIN_VALUE, 218, 222, 28, 10
    CONTROL         "&Auto", IDC_MIC_GAIN_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 248, 220, 44, 12
    LTEXT           "System", IDC_SYSTEM_METER_LABEL, 12, 244, 40, 10
    LTEXT           "", IDC_METER_SYSTEM, 54, 242, 250, 14, SS_NOTIFY
    RTEXT           "-inf dB", IDC_SYSTEM_DB, 308, 244, 40, 10

    LTEXT           "", IDC_DEVICE_WARNING, 12, 264, 336, 14
END

IDD_RECORDINGS_PAGE DIALOGEX 0, 0, 480, 260
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_RECORDINGS_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP,
                    8, 8, 220, 244
    LTEXT           "Select a recording", IDC_REC_DETAIL_EMPTY, 240, 100, 220, 20, SS_CENTER
    PUSHBUTTON      "&Play", IDC_REC_DETAIL_PLAY, 240, 8, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&Stop", IDC_REC_DETAIL_STOP, 296, 8, 50, 14, WS_TABSTOP | WS_DISABLED
    EDITTEXT        IDC_REC_DETAIL_TRANSCRIPT, 240, 28, 232, 200,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Create transcript", IDC_REC_DETAIL_CREATE, 240, 120, 120, 16, WS_TABSTOP
    LTEXT           "", IDC_REC_DETAIL_STATUS, 240, 144, 220, 40
END

IDD_RENAME_DIALOG DIALOGEX 0, 0, 260, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename recording"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&New name:", -1, 12, 14, 50, 10
    EDITTEXT        IDC_RENAME_EDIT, 12, 28, 236, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 140, 52, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 198, 52, 50, 14, WS_TABSTOP
END

IDD_SETTINGS DIALOGEX 0, 0, 420, 390
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Recording", -1, 8, 6, 404, 168
    LTEXT           "Save &folder:", -1, 16, 22, 60, 10
    EDITTEXT        IDC_SET_FOLDER, 80, 20, 276, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&...", IDC_SET_BROWSE_FOLDER, 362, 19, 40, 16, WS_TABSTOP
    LTEXT           "&Microphone:", -1, 16, 42, 60, 10
    COMBOBOX        IDC_SET_MIC_DEVICE, 80, 40, 322, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "S&ystem audio:", -1, 16, 62, 60, 10
    COMBOBOX        IDC_SET_SYS_DEVICE, 80, 60, 322, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Mic &gain:", -1, 16, 84, 60, 10
    EDITTEXT        IDC_SET_MIC_GAIN, 80, 82, 50, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "&Auto", IDC_SET_MIC_AGC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 138, 84, 44, 12
    LTEXT           "S&ys gain:", -1, 190, 84, 48, 10
    EDITTEXT        IDC_SET_SYS_GAIN, 242, 82, 50, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "Save separate &stems (*.mic.wav / *.system.wav)", IDC_SET_SAVE_STEMS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 104, 280, 12
    CONTROL         "Compress to &M4A after recording (AAC 128 kbps)", IDC_SET_COMPRESS_M4A, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 120, 280, 12
    CONTROL         "&Keep WAV after compression", IDC_SET_KEEP_WAV, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 32, 136, 200, 12
    CONTROL         "Ask driver for &communications processing (AEC/NS)", IDC_SET_COMMS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 152, 300, 12
    LTEXT           "Headphones avoid echo; this only requests driver processing.", IDC_SET_COMMS_NOTE, 32, 166, 360, 10

    GROUPBOX        "Transcription", -1, 8, 180, 404, 100
    LTEXT           "M&odel:", -1, 16, 198, 40, 10
    COMBOBOX        IDC_SET_MODEL, 60, 196, 200, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Download", IDC_SET_MODEL_DOWNLOAD, 268, 195, 60, 16, WS_TABSTOP
    PUSHBUTTON      "&Browse…", IDC_SET_MODEL_BROWSE, 334, 195, 60, 16, WS_TABSTOP
    LTEXT           "&Language:", -1, 16, 220, 48, 10
    COMBOBOX        IDC_SET_LANGUAGE, 70, 218, 80, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Threads:", -1, 170, 220, 40, 10
    EDITTEXT        IDC_SET_THREADS, 214, 218, 40, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "&Auto-transcribe after recording", IDC_SET_AUTO_TRANSCRIBE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 242, 200, 12
    CONTROL         "Use &VAD (silero)", IDC_SET_USE_VAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 258, 140, 12

    GROUPBOX        "General", -1, 8, 286, 404, 68
    CONTROL         "Close button minimizes to &tray", IDC_SET_CLOSE_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 302, 180, 12
    CONTROL         "Start with &Windows", IDC_SET_START_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 302, 120, 12
    CONTROL         "Start &minimized to tray", IDC_SET_START_MINIMIZED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 318, 160, 12
    CONTROL         "Enable global &hotkey", IDC_SET_HOTKEY_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 334, 120, 12
    EDITTEXT        IDC_SET_HOTKEY, 140, 332, 100, 14, ES_AUTOHSCROLL | WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 308, 366, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 364, 366, 50, 14, WS_TABSTOP
END

IDR_RECORDINGS_MENU MENU
BEGIN
    POPUP "Recordings"
    BEGIN
        MENUITEM "&Play",              IDC_REC_PLAY
        MENUITEM "&Transcribe",        IDC_REC_TRANSCRIBE
        MENUITEM SEPARATOR
        MENUITEM "Open &folder",       IDC_REC_OPENFOLDER
        MENUITEM "&Rename…",           IDC_REC_RENAME
        MENUITEM "&Delete",            IDC_REC_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Refres&h",           IDC_REC_REFRESH
    END
END

1 24 "Skrivli.manifest"
