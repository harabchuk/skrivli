#include "resource.h"
#include <windows.h>
#include <winres.h>
#include <atlres.h>

IDI_TRAY_IDLE      ICON "tray_idle.ico"
IDI_TRAY_RECORDING ICON "tray_recording.ico"

IDR_MAINFRAME ICON "app.ico"

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Open &recordings folder", ID_FILE_OPENFOLDER
        MENUITEM "Se&ttings...",            ID_FILE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About MeetingBuddy...",  ID_APP_ABOUT
    END
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "&Show MeetingBuddy",      ID_TRAY_SHOW
        MENUITEM "&Start recording",        ID_TRAY_STARTSTOP
        MENUITEM SEPARATOR
        MENUITEM "Open &recordings folder", ID_TRAY_OPENFOLDER
        MENUITEM "Se&ttings...",            ID_TRAY_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   ID_TRAY_EXIT
    END
END

IDD_RECORD_PAGE DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Microphone:", IDC_MIC_LABEL, 12, 12, 70, 10
    COMBOBOX        IDC_MIC_DEVICE, 90, 10, 258, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "&System audio:", IDC_SYSTEM_LABEL, 12, 32, 70, 10
    COMBOBOX        IDC_SYSTEM_DEVICE, 90, 30, 258, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Save &to:", IDC_FOLDER_LABEL, 12, 52, 70, 10
    EDITTEXT        IDC_FOLDER_PATH, 90, 50, 218, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&...", IDC_BROWSE_FOLDER, 314, 49, 34, 16, WS_TABSTOP

    PUSHBUTTON      "&Record", IDC_RECORD_BUTTON, 120, 84, 120, 32, WS_TABSTOP
    CTEXT           "00:00:00", IDC_ELAPSED, 120, 122, 120, 12

    LTEXT           "Mic", IDC_MIC_METER_LABEL, 12, 152, 40, 10
    LTEXT           "", IDC_METER_MIC, 54, 150, 294, 14, SS_NOTIFY
    LTEXT           "System", IDC_SYSTEM_METER_LABEL, 12, 176, 40, 10
    LTEXT           "", IDC_METER_SYSTEM, 54, 174, 294, 14, SS_NOTIFY

    LTEXT           "", IDC_DEVICE_WARNING, 12, 200, 336, 20
END

IDD_RECORDINGS_PAGE DIALOGEX 0, 0, 360, 220
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON      "&Play", IDC_REC_PLAY, 12, 8, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&Transcribe", IDC_REC_TRANSCRIBE, 66, 8, 60, 14, WS_TABSTOP | WS_DISABLED
    PUSHBUTTON      "&View", IDC_REC_VIEW, 130, 8, 50, 14, WS_TABSTOP | WS_DISABLED
    PUSHBUTTON      "&Folder", IDC_REC_OPENFOLDER, 184, 8, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&Rename", IDC_REC_RENAME, 238, 8, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&Delete", IDC_REC_DELETE, 292, 8, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Refres&h", IDC_REC_REFRESH, 12, 26, 50, 14, WS_TABSTOP
    CONTROL         "", IDC_RECORDINGS_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP,
                    12, 46, 336, 162
END

IDD_RENAME_DIALOG DIALOGEX 0, 0, 260, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename recording"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "New name:", -1, 12, 14, 50, 10
    EDITTEXT        IDC_RENAME_EDIT, 12, 28, 236, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 140, 52, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 198, 52, 50, 14, WS_TABSTOP
END

IDR_RECORDINGS_MENU MENU
BEGIN
    POPUP "Recordings"
    BEGIN
        MENUITEM "&Play",              IDC_REC_PLAY
        MENUITEM "&Transcribe",        IDC_REC_TRANSCRIBE
        MENUITEM "&View transcript",   IDC_REC_VIEW
        MENUITEM SEPARATOR
        MENUITEM "Open &folder",       IDC_REC_OPENFOLDER
        MENUITEM "&Rename…",           IDC_REC_RENAME
        MENUITEM "&Delete",            IDC_REC_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Refres&h",           IDC_REC_REFRESH
    END
END

1 24 "MeetingBuddy.manifest"
