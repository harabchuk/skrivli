Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers

WarningsAsErrors: ''
# Match project headers whether clang-tidy prints src/foo.hpp or an absolute Windows path.
# A bare "include/" segment would also match the Windows SDK Include directory.
HeaderFilterRegex: '(^(src|include)/|(^|[\\/])src[\\/])'
FormatStyle: file
